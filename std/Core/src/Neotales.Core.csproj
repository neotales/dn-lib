<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>$(Fx)</TargetFramework>
    <!--
      The assembly is Neotales.Core and the public namespaces are Neotales and
      its sub namespaces, one per folder. RootNamespace is what keeps the folder
      and namespace rule (IDE0130) satisfied without renaming a published
      namespace in a move.
    -->
    <RootNamespace>Neotales</RootNamespace>
    <Description>The runtime primitives the other packages build on: environment variable reading and expansion, result and option types, ordered maps, tee writers, disposable temporary files, and the unix file system interop.
It is a library of building blocks with no configuration store, no dependency injection container and no async task runner of its own.
It does not resolve configuration files, and it does not manage a process.</Description>
    <PackageTags>std core primitives result option environment collections interop dotnet</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Analyzer exceptions">
    <!--
      Rules that ask for a change to the published surface or to a name a consumer
      sees. Each is turned off here with its reason rather than acted on silently
      during a move; each is a ticket.

        CA1715, CA1716  type parameter and type names that do not follow the naming
                       conventions, and names that collide with a keyword in Visual
                       Basic or F#. `Option`, `Error` and a type parameter named `U`
                       or `E` are the published names.
        CA1000          static members on a generic type, which is how `Option<T>`,
                       `Result<T, E>` and `Map<T>` expose their `None` and `Fail`
                       values without a non generic twin.
        CA2231          comparison operators on a type that implements IComparable.
        RS0026, RS0027  several overloads taking optional parameters, which is how
                       the file, environment and result helpers let a caller omit the
                       common arguments.
        CA1069          `FileSystemEntryType.All` and `SymbolicLink` have the same
                       constant value. That is a defect in the enum, and fixing it
                       changes behaviour, so it is a ticket rather than an edit.
        CA1805, CA1816, CA1062 style members that are explicit about a
                       default. Removing the initialisation is a behaviour change for
                       a diagnostic tool that reads the field.

      Delete the corresponding entry in the pull request that resolves it.
    -->
    <!--
      The counts are what each code fires today, measured by rebuilding with this
      list cleared. They are here so a reader can tell a load-bearing suppression
      from a stale one without doing that themselves: a code at zero is a line to
      delete, and a code well below its count has narrowed.

        CA1715  94    CA1000  38    CA1716  12
        CA1805   4    CA1816   4    CA2231  2
    -->
        <NoWarn>$(NoWarn);CA1000;CA1069;CA1715;CA1716;CA1805;CA1816;CA2231;RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Package specific. The unix interop calls unmanaged functions through
      function pointers and the struct layouts are explicit, so this project
      needs unsafe blocks.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Label="Shared sources">
    <!--
      The unix bindings are shared source files in cmn/src. They are compiled
      into this package through explicit links; cmn is not a runtime library.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/libc/chown.cs" Link="FFI/Unix/chown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/libc/chmod.cs" Link="FFI/Unix/chmod.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/libc/getgrgid.cs" Link="FFI/Unix/getgrgid.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/system.native/stat.cs" Link="FFI/Unix/stat.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/errors.cs" Link="FFI/Unix/Errors.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/system.native/getpwuid.cs" Link="FFI/Unix/getpwuid.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../cmn/src/ffi/unix/libs.cs" Link="FFI/Unix/Libs.cs" />
  </ItemGroup>

</Project>
