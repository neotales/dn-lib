# Normalise text to LF in the repository.
* text=auto eol=lf

# Fixtures and release artifacts are bytes. A lone CR in a fixture is data.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.zip binary
*.nupkg binary
*.snupkg binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.kdbx binary
*.age binary
*.der binary
*.p12 binary
*.pfx binary

# Vendored third-party sources stay out of the language statistics.
vendor/** linguist-vendored

# A library lockfile is committed so CI builds one commit the same way twice.
# Linguist still treats it as generated.
packages.lock.json linguist-generated=true

# Build output, if a bin or obj directory is ever force-added.
bin/** linguist-generated=true linguist-vendored
obj/** linguist-generated=true linguist-vendored
.artifacts/** linguist-generated=true linguist-vendored
