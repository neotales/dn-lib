<Project>
  <PropertyGroup>
    <Company>Neotales</Company>
    <Authors>Neotales</Authors>
    <Copyright>Copyright (c) Neotales</Copyright>
  </PropertyGroup>
  <!--
    ReleaseLabel is the prerelease channel from a tag, such as beta.3.
    Each project keeps its own Version, which is also the assembly version.
    The package version is that Version plus the label. An explicit
    PackageVersion, including a dev-build override, is left alone.
    VersionSuffix is not used: an explicit Version ignores it, so a
    prerelease tag would pack the stable version.
  -->
  <PropertyGroup Condition="'$(ReleaseLabel)' != '' and '$(PackageVersion)' == ''">
    <PackageVersion>$(Version)-$(ReleaseLabel)</PackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageId>$(AssemblyName)</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotesFile>CHANGELOG.md</PackageReleaseNotesFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory).artifacts/packages/</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!--
    Shipped libraries are trimmable. Test projects and the eng scripts are not
    libraries, and this group runs after the test project clears IsPackable.
    IsTrimmable turns on the trim analyzer for the library itself.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(IsTestProject)' != 'true'">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(IsTestProject)' != 'true'">
    <AssemblyMetadata Include="IsTrimmable" Value="True" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Condition="Exists('THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <Using Include="Xunit" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('xunit.runner.json')" />
  </ItemGroup>
</Project>
